# Template only — copy to `.env.local` and fill in real values there.
# NEVER put a real key in this file: it is committed to a public repository.

# ---- Supabase ----
# From your Supabase project: Settings -> API Keys.
# The "anon" var name predates Supabase's rename; paste the PUBLISHABLE key
# (sb_publishable_...) here. Safe to expose — it is shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# ---- App ----
# Public base URL of the tap/redirect service.
# Local dev: http://localhost:3000
# Production: https://taptap.hornbilltech.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Sign-in ----
# Shows the "Continue with Google" button. Leave unset until the Google provider
# is actually enabled in Supabase (Authentication -> Providers -> Google) with
# credentials from Google Cloud — the button is the most prominent control on
# the sign-in screen, so shipping it before it works fails every user who trusts
# it. NEXT_PUBLIC_* is inlined at build time, so switching this on needs a
# redeploy, not just an env change.
#
# Email sending (confirmation + magic links) is configured entirely in the
# Supabase dashboard under Project Settings -> Authentication -> SMTP Settings.
# The Resend API key belongs there and NEVER in this repo — it is public.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=

# ---- Notifications (Sprint UI-13) ----
# Server-only. Sends the "new lead" email. Get it from resend.com -> API Keys.
# The SAME key can be pasted into Supabase's SMTP settings for auth mail, but
# these are two separate paths: Supabase sends magic links, this sends product
# notifications. NEVER commit the real value — this repo is public.
RESEND_API_KEY=
# The From address. Must be on a domain verified in Resend (SPF + DKIM), or mail
# lands in spam. e.g. "Hornbill TapTap <alerts@hornbilltech.co.ke>"
NOTIFY_FROM=

# ---- Renewal reminders cron (D-018) ----
# Server-only. Guards /api/cron/renewals, which emails customers whose cards are
# about to stop working. Vercel Cron sends it as "Authorization: Bearer <value>"
# and generates a strong value automatically when you add a cron in the
# dashboard — set it there rather than by hand where possible.
#
# Same rules as ADMIN_TOKEN: at least 24 characters, no placeholders. The route
# refuses to run otherwise, because an unguarded URL that sends mail to every
# customer is a spam cannon anyone can fire. See app/api/cron/renewals/route.ts.
# Generate: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
CRON_SECRET=

# ---- Billing (Sprint 4) ----
# Server-only. Bypasses RLS — payment callbacks use it to activate subscriptions,
# and /admin uses it to mint cards. Supabase: Settings -> API Keys -> Create new
# secret key (sb_secret_...). The var name predates the rename; the name stays.
# NEVER expose to the client and NEVER commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# M-Pesa Daraja (Safaricom developer portal). Start with sandbox.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# 174379 is Safaricom's public sandbox shortcode; replace for production.
MPESA_SHORTCODE=174379
# Sandbox passkey is published on the Daraja portal; production is issued to you.
MPESA_PASSKEY=your-daraja-passkey
# Optional — defaults to NEXT_PUBLIC_SITE_URL + /api/mpesa/callback (must be public HTTPS)
MPESA_CALLBACK_URL=

# ---- Admin (Sprint 5) ----
# Long random secret that gates the /admin card-minting page.
# Generate: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
#
# Must be at least 24 characters and must not be a placeholder. Minting refuses
# to run otherwise — /admin is publicly reachable, so a guessable value here is
# the same as no protection at all. See lib/admin-auth.ts.
ADMIN_TOKEN=your-long-random-admin-secret
