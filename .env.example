# Template only — copy to `.env.local` and fill in real values there.
# NEVER put a real key in this file: it is committed to a public repository.

# ---- Supabase ----
# From your Supabase project: Settings -> API Keys.
# The "anon" var name predates Supabase's rename; paste the PUBLISHABLE key
# (sb_publishable_...) here. Safe to expose — it is shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# ---- App ----
# Public base URL of the tap/redirect service.
# Local dev: http://localhost:3000
# Production: https://taptap.hornbilltech.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Billing (Sprint 4) ----
# Server-only. Bypasses RLS — payment callbacks use it to activate subscriptions,
# and /admin uses it to mint cards. Supabase: Settings -> API Keys -> Create new
# secret key (sb_secret_...). The var name predates the rename; the name stays.
# NEVER expose to the client and NEVER commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# M-Pesa Daraja (Safaricom developer portal). Start with sandbox.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# 174379 is Safaricom's public sandbox shortcode; replace for production.
MPESA_SHORTCODE=174379
# Sandbox passkey is published on the Daraja portal; production is issued to you.
MPESA_PASSKEY=your-daraja-passkey
# Optional — defaults to NEXT_PUBLIC_SITE_URL + /api/mpesa/callback (must be public HTTPS)
MPESA_CALLBACK_URL=

# ---- Admin (Sprint 5) ----
# Long random secret that gates the /admin card-minting page.
# Generate: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
#
# Must be at least 24 characters and must not be a placeholder. Minting refuses
# to run otherwise — /admin is publicly reachable, so a guessable value here is
# the same as no protection at all. See lib/admin-auth.ts.
ADMIN_TOKEN=your-long-random-admin-secret
